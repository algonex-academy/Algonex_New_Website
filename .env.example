# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Option 1: Supabase Connection String (Recommended)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (use Transaction pooler port 6543)
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database — Option 2: Supabase / PostgreSQL Individual Variables
# DB_ENGINE=postgresql
# DB_NAME=postgres
# DB_USER=postgres.yourprojectref
# DB_PASSWORD=your-database-password
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=600

# Database — Option 3: Local PostgreSQL / Docker Compose
# DB_NAME=algonex
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_CONN_MAX_AGE=600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# OAuth (optional — get from Google/GitHub developer console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (required for password reset and registration invites)
# For development, Django uses console backend (prints to terminal).
# For production, configure SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Caddy / Domain
DOMAIN=localhost

# Buddy AI Chatbot (get your key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# To switch provider, set BUDDY_LLM_PROVIDER=openai and add:
# OPENAI_API_KEY=
