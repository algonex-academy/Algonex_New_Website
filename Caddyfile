{$DOMAIN}, algonex.co.in, www.algonex.co.in {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    @api {
        path /api /api/*
    }
    handle @api {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    @admin {
        path /admin /admin/*
    }
    handle @admin {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Django static files (admin CSS/JS) — served directly by Caddy
    handle /static/* {
        root * /srv
        file_server
    }

    # Media files (uploads) — served directly by Caddy
    handle /media/* {
        root * /srv
        file_server
    }

    # React SPA hashed assets — safe to cache for 1 year
    @assets {
        path /assets/*
    }
    handle @assets {
        root * /srv/frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # React SPA — serve static files, fallback to index.html with NO CACHE
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        header Pragma "no-cache"
        header Expires "0"
        file_server
    }
}
